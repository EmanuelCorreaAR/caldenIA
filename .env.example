# PostgreSQL local o managed (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/caldenia?schema=public"

# Firma de sesión (cookie). En prod usá un string largo aleatorio.
AUTH_SECRET="cambia-este-secreto-largo"

# Seed del operador de plataforma (mismo /login que todos)
PLATFORM_ADMIN_EMAIL="emanuel@caldenia.local"
PLATFORM_ADMIN_NAME="Emanuel"
PLATFORM_ADMIN_PASSWORD="caldenia-admin"

# Opcional: interpretación de formularios desde imagen (próximo)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
